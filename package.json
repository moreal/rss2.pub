{
  "name": "rss2pub",
  "version": "0.0.0",
  "private": true,
  "description": "Atom to ActivityPub bridge — each feed becomes a followable fediverse actor",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "atom:conformance:update": "node scripts/update-w3c-atom-manifest.mjs vendor/w3c-feedvalidator 9ce274c9db93796b8ab2a44952b9da80811bf765",
    "dev": "yarn workspace @rss2pub/atom-feed build && node --watch --env-file-if-exists=.env --import tsx src/web/main.ts",
    "db:reset": "./scripts/db-reset.sh",
    "typecheck": "yarn workspace @rss2pub/atom-feed typecheck && tsc --noEmit",
    "build": "yarn workspace @rss2pub/atom-feed build && tsc -p tsconfig.build.json",
    "test": "yarn workspace @rss2pub/atom-feed build && vitest run",
    "test:unit": "yarn workspace @rss2pub/atom-feed build && vitest run --project unit",
    "test:e2e": "yarn workspace @rss2pub/atom-feed build && vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile"
  },
  "devDependencies": {
    "@lingui/cli": "^6.6.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^24",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fedify/botkit": "0.6.0-dev.348",
    "@fedify/botkit-postgres": "0.6.0-dev.348",
    "@fedify/fedify": "~2.3.5",
    "@fedify/postgres": "^2.3.3",
    "@fedify/vocab": "~2.3.5",
    "@hono/node-server": "^2.0.11",
    "@lingui/core": "^6.6.0",
    "@logtape/logtape": "^2.2.4",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@rss2pub/atom-feed": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "linkedom": "^0.18.13",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.6"
  }
}
