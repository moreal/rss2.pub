# Copy to selfhost.env and keep it private. Use a URL-safe password, for example
# the output of: openssl rand -hex 24
RSS2PUB_VERSION=v0.1.0
ORIGIN=https://feeds.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-string
# Set this to your fork's corresponding source if you deploy modified code.
SOURCE_URL=https://github.com/moreal/rss2.pub
# Conservative admission controls can be tuned for the host's capacity.
REGISTRATION_ATTEMPTS_PER_HOUR=60
REGISTRATION_DAILY_LIMIT=20
REGISTRATION_TOTAL_LIMIT=1000
